<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests: pure logic, no game running. Logic worth testing lives in classes without Unity / Valheim types; link those files here
       (<Compile Include="..\..\SteveTheTroll-Mod\src\...\X.cs" Link="Mod\X.cs" />) or reach them in the built DLL through ModAssembly.
       Unity's plain value types (Vector3, Bounds, Mathf, Color) are managed code and work here; anything that calls into the engine
       (ColorUtility.TryParseHtmlString, GameObject, ...) does not - test that in game (InGameTests).
       How good the tests are: _agent\tools\test-quality.ps1 (coverage + mutation score, E:\Projects\Valheim\Claude\testing\TEST_QUALITY.md). -->
  <PropertyGroup>
    <AssemblyName>SteveTheTroll.UnitTests</AssemblyName>
    <RootNamespace>SteveTheTroll.Tests.Unit</RootNamespace>
  </PropertyGroup>
  <!-- Linked copies only in normal runs; in test-quality runs (KydlQuality=true) the tests use the mod's types (InternalsVisibleTo), so
       Stryker / coverage measure the mod code itself (D-086). -->
  <ItemGroup Condition="'$(KydlQuality)' != 'true'">
    <!-- D-039 menu: pure UI logic from the Unity project (shared viewer from the template + Slippers / Troll work tabs) -->
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\ViewerSettings.cs" Link="Ui\ViewerSettings.cs" />
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\ViewerMath.cs" Link="Ui\ViewerMath.cs" />
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\ViewerOrbit.cs" Link="Ui\ViewerOrbit.cs" />
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\DetailRow.cs" Link="Ui\DetailRow.cs" />
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\DetailGroup.cs" Link="Ui\DetailGroup.cs" />
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\SlipperData.cs" Link="Ui\SlipperData.cs" />
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\SlipperDetailsBuilder.cs" Link="Ui\SlipperDetailsBuilder.cs" />
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\CostumeData.cs" Link="Ui\CostumeData.cs" />
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\CostumeDetailsBuilder.cs" Link="Ui\CostumeDetailsBuilder.cs" />
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\TrollFocus.cs" Link="Ui\TrollFocus.cs" />
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\TrollInfo.cs" Link="Ui\TrollInfo.cs" />
    <Compile Include="..\..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\TrollDetailsBuilder.cs" Link="Ui\TrollDetailsBuilder.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(KydlQuality)' != 'true'">
    <!-- which functionalities are on (PROJECT_RULES 11) -->
    <Compile Include="..\..\SteveTheTroll-Mod\src\Functions.cs" Link="Mod\Functions.cs" />
    <!-- D-135 Troll Hub: pure rules + the building's data -->
    <Compile Include="..\..\SteveTheTroll-Mod\src\Hub\HubRules.cs" Link="Mod\HubRules.cs" />
    <Compile Include="..\..\SteveTheTroll-Mod\src\Taming\IdleRules.cs" Link="Mod\IdleRules.cs" />
    <Compile Include="..\..\SteveTheTroll-Mod\src\Backpack\DepotRules.cs" Link="Mod\DepotRules.cs" />
    <Compile Include="..\..\SteveTheTroll-Mod\src\Taming\HealthRules.cs" Link="Mod\HealthRules.cs" />
    <!-- D-167 stuck detection and recovery: pure rules, the escalation ladder, the per troll + resource failure book (TargetRules: head-on test) -->
    <Compile Include="..\..\SteveTheTroll-Mod\src\Taming\StuckRules.cs" Link="Mod\StuckRules.cs" />
    <Compile Include="..\..\SteveTheTroll-Mod\src\Taming\RecoveryMachine.cs" Link="Mod\RecoveryMachine.cs" />
    <Compile Include="..\..\SteveTheTroll-Mod\src\Taming\TargetRules.cs" Link="Mod\TargetRules.cs" />
    <Compile Include="..\..\SteveTheTroll-Mod\src\Hub\HubData.cs" Link="Mod\HubData.cs" />
    <!-- D-169 Architecture V2: the game-free foundation (typed responses, validation, commands, pipeline) -->
    <Compile Include="..\..\SteveTheTroll-Mod\src\Core\**\*.cs" Link="Mod\Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimRefs)\UnityEngine.CoreModule.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
