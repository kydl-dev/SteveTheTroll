{
  "name": "slipper-figures",
  "description": "Slippers on, run and turn: the little trolls stay on top of the slippers (measured against the slipper's own bounds, D-160)",
  "timeout": 90,
  "steps": [
    { "do": "hook", "name": "stt.reset" },
    { "do": "give", "prefab": "STT_TrollSlippers", "count": 1, "equip": true },
    { "do": "wait", "seconds": 7 },
    { "do": "hook", "name": "stt.figureCount", "expect": 2, "label": "a figure on each slipper (measured)" },
    { "do": "holdKey", "key": "LeftShift", "on": true },
    { "do": "holdKey", "key": "W", "on": true },
    { "do": "wait", "seconds": 3 },
    { "do": "holdKey", "key": "D", "on": true },
    { "do": "wait", "seconds": 3 },
    { "do": "holdKey", "key": "D", "on": false },
    { "do": "wait", "seconds": 3 },
    { "do": "releaseKeys" },
    { "do": "wait", "seconds": 6 },
    { "do": "hook", "name": "stt.figures" }
  ],
  "asserts": [
    { "check": "hook", "name": "stt.figuresOk", "expect": true, "label": "no figure under or inside a slipper, none tilted over 60 deg" },
    { "check": "logContains", "source": "SteveTheTroll", "text": "RuntimeHealth", "expect": false, "label": "the health monitor reported nothing" },
    { "check": "noErrors", "source": "SteveTheTroll" }
  ]
}
