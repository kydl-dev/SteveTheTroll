{
  "name": "guard-mob",
  "description": "D-171 P5: a creature near the troll goes for the player - the troll takes it on (TrollGuard, GuardRules)",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "stt.reset"
    },
    {
      "do": "hook",
      "name": "stt.clearTrolls"
    },
    {
      "do": "give",
      "prefab": "STT_TrollSlippers",
      "count": 1,
      "equip": true
    },
    {
      "do": "hook",
      "name": "stt.addHub",
      "args": {
        "number": 1,
        "dx": 0,
        "dz": 25
      }
    },
    {
      "do": "hook",
      "name": "stt.spawnTroll",
      "args": {
        "dx": -6,
        "dz": -2
      },
      "as": "troll"
    },
    {
      "do": "spawn",
      "prefab": "Greydwarf",
      "dx": -9,
      "dz": -2,
      "as": "mob"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "stt.mobTargetsPlayer",
      "args": {
        "mob": "mob"
      },
      "expect": true
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "stt.targetOf",
        "args": {
          "troll": "troll"
        },
        "expect": "Greydwarf"
      },
      "timeout": 5
    }
  ],
  "asserts": [
    {
      "check": "hook",
      "name": "stt.targetOf",
      "args": {
        "troll": "troll"
      },
      "expect": "Greydwarf"
    },
    {
      "check": "noErrors",
      "source": "SteveTheTroll"
    }
  ]
}