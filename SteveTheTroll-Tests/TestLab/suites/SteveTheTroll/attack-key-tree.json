{
  "name": "attack-key-tree",
  "description": "D-171: the player walks (user idea 2026-11-02: the player goes 100 m further out from the test spot, away from the lab start (stt.arenaFurther; a plain dx teleport went back to the lab house) and the target is 15 m in front - no no-hit ring, no arena colliders in the ray; stt.aimAt aims the ray; teleports, so it runs at the end)",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "stt.reset"
    },
    {
      "do": "hook",
      "name": "stt.clearTrolls"
    },
    {
      "do": "give",
      "prefab": "STT_TrollSlippers",
      "count": 1,
      "equip": true
    },
    {
      "do": "hook",
      "name": "stt.addHub",
      "args": {
        "number": 1,
        "dx": 0,
        "dz": 25
      }
    },
    {
      "do": "hook",
      "name": "stt.arenaFurther",
      "args": {
        "metres": 100
      }
    },
    {
      "do": "hook",
      "name": "stt.clearAround",
      "args": {
        "radius": 30
      },
      "label": "no world tree / bush between the player and the target (D-172)"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "stt.plantTree",
      "args": {
        "dx": 0,
        "dz": 15
      },
      "as": "tree"
    },
    {
      "do": "hook",
      "name": "stt.spawnTroll",
      "args": {
        "dx": -14,
        "dz": 8
      },
      "as": "troll"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "face",
      "target": "tree"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "stt.aimAt",
      "args": {
        "target": "tree"
      },
      "expect": true
    },
    {
      "do": "hook",
      "name": "stt.attackKeyPress",
      "args": {
        "count": 1
      }
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "stt.plantedUntouched",
        "expect": 0
      },
      "timeout": 45
    }
  ],
  "asserts": [
    {
      "check": "hook",
      "name": "stt.plantedUntouched",
      "expect": 0,
      "label": "the tree the player looked at was hit"
    },
    {
      "check": "logContains",
      "source": "SteveTheTroll",
      "text": "ordered to break Beech1",
      "expect": true
    },
    {
      "check": "noErrors",
      "source": "SteveTheTroll"
    }
  ]
}
