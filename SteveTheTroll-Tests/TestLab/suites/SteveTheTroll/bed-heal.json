{
  "name": "bed-heal",
  "description": "D-171 P7: a hurt tamed troll near the bed heals (D-085, HomeRules.InHealRange)",
  "timeout": 40,
  "steps": [
    {
      "do": "hook",
      "name": "stt.reset"
    },
    {
      "do": "hook",
      "name": "stt.clearTrolls"
    },
    {
      "do": "give",
      "prefab": "STT_TrollSlippers",
      "count": 1,
      "equip": true
    },
    {
      "do": "hook",
      "name": "stt.addHub",
      "args": {
        "number": 1,
        "dx": 0,
        "dz": 25
      }
    },
    {
      "do": "hook",
      "name": "stt.spawnTroll",
      "args": {
        "dx": -8,
        "dz": -8
      },
      "as": "troll"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "stt.hurtTroll",
      "args": {
        "troll": "troll",
        "damage": 300
      }
    },
    {
      "do": "hook",
      "name": "stt.trollMissingHealth",
      "args": {
        "troll": "troll"
      },
      "min": 1,
      "label": "hurt"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "stt.trollMissingHealth",
        "args": {
          "troll": "troll"
        },
        "expect": 0
      },
      "timeout": 20
    }
  ],
  "asserts": [
    {
      "check": "hook",
      "name": "stt.trollMissingHealth",
      "args": {
        "troll": "troll"
      },
      "expect": 0,
      "label": "healed at the bed"
    },
    {
      "check": "noErrors",
      "source": "SteveTheTroll"
    }
  ]
}