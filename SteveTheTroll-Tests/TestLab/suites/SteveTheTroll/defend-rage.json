{
  "name": "defend-rage",
  "description": "D-171 P5: a creature hits the player - the own troll near the player goes into rage (D-082) and attacks it (D-042 / D-066)",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "stt.reset"
    },
    {
      "do": "hook",
      "name": "stt.clearTrolls"
    },
    {
      "do": "give",
      "prefab": "STT_TrollSlippers",
      "count": 1,
      "equip": true
    },
    {
      "do": "hook",
      "name": "stt.addHub",
      "args": {
        "number": 1,
        "dx": 0,
        "dz": 25
      }
    },
    {
      "do": "hook",
      "name": "stt.spawnTroll",
      "args": {
        "dx": -6,
        "dz": -2
      },
      "as": "troll"
    },
    {
      "do": "spawn",
      "prefab": "Greydwarf",
      "dx": 6,
      "dz": 2,
      "as": "mob"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "stt.hitPlayer",
      "args": {
        "attacker": "mob",
        "damage": 1
      }
    },
    {
      "do": "wait",
      "seconds": 1
    }
  ],
  "asserts": [
    {
      "check": "hook",
      "name": "stt.combatState",
      "args": {
        "troll": "troll"
      },
      "expect": "rage",
      "label": "enraged"
    },
    {
      "check": "hook",
      "name": "stt.targetOf",
      "args": {
        "troll": "troll"
      },
      "expect": "Greydwarf",
      "label": "targets the attacker"
    },
    {
      "check": "noErrors",
      "source": "SteveTheTroll"
    }
  ]
}