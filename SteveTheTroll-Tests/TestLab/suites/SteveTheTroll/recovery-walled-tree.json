{
  "name": "recovery-walled-tree",
  "description": "D-167: a tree inside a closed ring of player-built walls. The troll gets stuck, never attacks a wall, walks around (detours), fails two complete recovery cycles and blacklists THAT tree for itself (D-171: troll beside the player and the player looks away - after hold-look the player faced the troll's path and TrollHold froze it for the whole test)",
  "timeout": 420,
  "steps": [
    {
      "do": "hook",
      "name": "stt.reset"
    },
    {
      "do": "hook",
      "name": "stt.clearTrolls"
    },
    {
      "do": "give",
      "prefab": "STT_TrollSlippers",
      "count": 1,
      "equip": true
    },
    {
      "do": "hook",
      "name": "stt.walledTree",
      "args": {
        "dx": 0,
        "dz": 30,
        "radius": 6
      },
      "as": "tree"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "stt.wallsAlive",
      "min": 12,
      "label": "the whole ring stands"
    },
    {
      "do": "hook",
      "name": "stt.spawnTroll",
      "args": {
        "dx": 10,
        "dz": 5
      },
      "as": "troll"
    },
    {
      "do": "face",
      "dx": -30,
      "dz": 0
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "stt.farmOn",
      "args": {
        "troll": "troll",
        "source": "tree"
      },
      "expect": true,
      "label": "the troll is ordered to farm the walled tree"
    },
    {
      "do": "hook",
      "name": "stt.wallsAlive",
      "label": "walls still standing (diagnosis)"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "stt.blacklisted",
        "args": {
          "troll": "troll",
          "source": "tree"
        },
        "expect": true
      },
      "timeout": 360
    }
  ],
  "asserts": [
    {
      "check": "hook",
      "name": "stt.blacklisted",
      "args": {
        "troll": "troll",
        "source": "tree"
      },
      "expect": true
    },
    {
      "check": "hook",
      "name": "stt.wallsHit",
      "expect": 0
    },
    {
      "check": "hook",
      "name": "stt.treeStands",
      "args": {
        "tree": "tree"
      },
      "expect": 1
    },
    {
      "check": "noErrors",
      "source": "SteveTheTroll"
    }
  ]
}