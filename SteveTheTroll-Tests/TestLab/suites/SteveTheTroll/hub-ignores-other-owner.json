{
  "name": "hub-ignores-other-owner",
  "description": "A hub of another player is never used, however near",
  "timeout": 60,
  "steps": [
    { "do": "hook", "name": "stt.reset" },
    { "do": "hook", "name": "stt.spawnTroll", "args": { "dz": 4 }, "as": "troll" },
    { "do": "hook", "name": "stt.addHub", "args": { "number": 1, "dx": 20, "dz": 0, "owner": "other" } },
    { "do": "hook", "name": "stt.hubFor", "args": { "troll": "troll" }, "expect": 0, "label": "other player's hub 20 m away is ignored" },
    { "do": "hook", "name": "stt.addHub", "args": { "number": 2, "dx": 900, "dz": 0 } },
    { "do": "hook", "name": "stt.hubFor", "args": { "troll": "troll" }, "expect": 2 }
  ],
  "asserts": [ { "check": "noErrors", "source": "SteveTheTroll" } ]
}
