{
  "name": "backpack-full-cache",
  "description": "Full backpack: the cached answer follows a change at once (no stale 'full' after items are removed)",
  "timeout": 90,
  "steps": [
    {
      "do": "hook",
      "name": "stt.reset"
    },
    {
      "do": "give",
      "prefab": "STT_TrollSlippers",
      "count": 1,
      "equip": true
    },
    {
      "do": "hook",
      "name": "stt.slippers",
      "args": {
        "on": false
      },
      "expect": false,
      "label": "slippers off: the plugin sends no full troll to a depot (D-149) - the chests stay as the test filled them"
    },
    {
      "do": "hook",
      "name": "stt.clearTrolls"
    },
    {
      "do": "hook",
      "name": "stt.spawnTroll",
      "args": {
        "dx": 0,
        "dz": 20
      },
      "as": "troll"
    },
    {
      "do": "hook",
      "name": "stt.backpackFullCached",
      "args": {
        "troll": "troll"
      },
      "expect": false
    },
    {
      "do": "hook",
      "name": "stt.fillBackpack",
      "args": {
        "troll": "troll"
      }
    },
    {
      "do": "hook",
      "name": "stt.backpackFull",
      "args": {
        "troll": "troll"
      },
      "expect": true
    },
    {
      "do": "hook",
      "name": "stt.backpackFullCached",
      "args": {
        "troll": "troll"
      },
      "expect": true
    },
    {
      "do": "hook",
      "name": "stt.backpackAllUsed",
      "args": {
        "troll": "troll"
      },
      "expect": true,
      "label": "every slot used"
    },
    {
      "do": "hook",
      "name": "stt.unpackChest0",
      "args": {
        "troll": "troll"
      }
    },
    {
      "do": "hook",
      "name": "stt.backpackFullCached",
      "args": {
        "troll": "troll"
      },
      "expect": false,
      "label": "cache dropped by the write"
    },
    {
      "do": "hook",
      "name": "stt.unloading",
      "args": {
        "troll": "troll"
      },
      "expect": false,
      "label": "the troll never started an unload during the test"
    },
    {
      "do": "hook",
      "name": "stt.slippers",
      "args": {
        "on": true
      },
      "expect": true,
      "label": "slippers back on for the next tests"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "SteveTheTroll"
    }
  ]
}
