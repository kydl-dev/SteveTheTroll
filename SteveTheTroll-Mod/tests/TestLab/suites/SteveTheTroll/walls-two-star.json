{
    "name":  "walls-two-star",
    "description":  "D-171 P5: only 2-star tamed trolls may break fortress walls (D-124)",
    "timeout":  30,
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  true,
                                   "slippers":  true,
                                   "hub":  true
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  -12,
                                   "dz":  12
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.wallBreaker",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "expect":  false,
                      "label":  "no star: no walls"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.setLevel",
                      "args":  {
                                   "troll":  "troll",
                                   "level":  3
                               },
                      "expect":  3
                  }
              ],
    "asserts":  [
                    {
                        "check":  "hook",
                        "name":  "stt.wallBreaker",
                        "args":  {
                                     "troll":  "troll"
                                 },
                        "expect":  true,
                        "label":  "2 stars: walls"
                    },
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
