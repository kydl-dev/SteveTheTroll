{
    "name":  "instruction-latency",
    "description":  "D-176 / D-180: the home order takes effect at once (the farmer is in its home mode within 1 s), the troll starts towards its hub within 5 s and is 10 m closer within 12 s. Latency is checked as a state; the distances are separate checks. 2026-11-05: on cleared open ground (the old far spot measured terrain and, before the spawn fixes, a swim) - the 10 m / 12 s rate is to be re-confirmed on this ground.",
    "timeout":  90,
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  false,
                                   "slippers":  true,
                                   "hub":  false
                               }
                  },
                  {
                      "do":  "use",
                      "block":  "openGround",
                      "args":  {
                                   "metres":  35,
                                   "radius":  40
                               },
                      "label":  "2026-11-05 (gate runs): at the old spot (-41, 136) the troll had passed only by falling into the sea and SWIMMING at 18 m/s; on solid ground the route was terrain-blocked (1.2 m/s, detours) - the test measures the order, not the terrain, so the scene is on cleared open ground"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.addHub",
                      "args":  {
                                   "number":  1,
                                   "dx":  -15,
                                   "dz":  -5
                               },
                      "label":  "the hub behind-left of the player, ~46 m from the troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  15,
                                   "dz":  30
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.plantTree",
                      "args":  {
                                   "dx":  15,
                                   "dz":  38
                               },
                      "as":  "tree",
                      "label":  "something to farm next to the troll (the open ground has no trees)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.observe",
                      "args":  {
                                   "back":  15
                               },
                      "label":  "D-178: the player watches from 15 m back - the trolls work, unload and go to the bed without walking into the player"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.startFarm",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "expect":  true
                  },
                  {
                      "do":  "wait",
                      "seconds":  1
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.state",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "contains":  "farming",
                      "label":  "Go farm: farming within 1 s"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.mark",
                      "args":  {
                                   "troll":  "troll"
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.sendHome",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "expect":  true
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.goingHome",
                                    "args":  {
                                                 "troll":  "troll"
                                             },
                                    "expect":  true
                                },
                      "timeout":  1,
                      "label":  "latency: within 1 s of the order the troll is in its home mode (a state, not a distance - analysis option A)"
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.progressTowardHub",
                                    "args":  {
                                                 "troll":  "troll"
                                             },
                                    "min":  1
                                },
                      "timeout":  5,
                      "label":  "it is moving towards its hub within 5 s (turning round and the game\u0027s speed ramp take 2 - 3 s)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.moveSample",
                      "args":  {
                                   "troll":  "troll"
                               }
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.progressTowardHub",
                                    "args":  {
                                                 "troll":  "troll"
                                             },
                                    "min":  10
                                },
                      "timeout":  12,
                      "label":  "rate: within 12 s of the order the troll is at least 10 m closer to its hub (fix10 10 m at 6 s, fix8 12 m at 5 s; fix12 0 m at 3 s after a slow start)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.moveSample",
                      "args":  {
                                   "troll":  "troll"
                               }
                  }
              ],
    "asserts":  [
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
