{
    "name":  "instruction-latency",
    "description":  "D-176 / D-180: the home order takes effect at once (the farmer is in its home mode within 1 s), the troll starts towards its hub within 5 s and is 10 m closer within 12 s. Latency is checked as a state; the distances are separate, calibrated checks (fix8 12 m @ 5 s, fix9 10.8 m @ 6.1 s, fix10 10.0 m @ ~6 s, fix12 0 m @ 3 s).",
    "timeout":  90,
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  false,
                                   "slippers":  true,
                                   "hub":  true
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dz":  67,
                                   "dx":  -20
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.clearAroundTroll",
                      "args":  {
                                   "troll":  "troll",
                                   "radius":  15
                               },
                      "label":  "fix11: clutter at the troll\u0027s start boxed it in - this test measures the order, not the terrain (clutter has its own tests)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.observe",
                      "args":  {
                                   "back":  15
                               },
                      "label":  "D-178: the player watches from 15 m back - the trolls work, unload and go to the bed without walking into the player"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.startFarm",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "expect":  true
                  },
                  {
                      "do":  "wait",
                      "seconds":  1
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.state",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "contains":  "farming",
                      "label":  "Go farm: farming within 1 s"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.mark",
                      "args":  {
                                   "troll":  "troll"
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.sendHome",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "expect":  true
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.goingHome",
                                    "args":  {
                                                 "troll":  "troll"
                                             },
                                    "expect":  true
                                },
                      "timeout":  1,
                      "label":  "latency: within 1 s of the order the troll is in its home mode (a state, not a distance - analysis option A)"
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.progressTowardHub",
                                    "args":  {
                                                 "troll":  "troll"
                                             },
                                    "min":  1
                                },
                      "timeout":  5,
                      "label":  "it is moving towards its hub within 5 s (turning round and the game\u0027s speed ramp take 2 - 3 s)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.moveSample",
                      "args":  {
                                   "troll":  "troll"
                               }
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.progressTowardHub",
                                    "args":  {
                                                 "troll":  "troll"
                                             },
                                    "min":  10
                                },
                      "timeout":  12,
                      "label":  "rate: within 12 s of the order the troll is at least 10 m closer to its hub (fix10 10 m at 6 s, fix8 12 m at 5 s; fix12 0 m at 3 s after a slow start)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.moveSample",
                      "args":  {
                                   "troll":  "troll"
                               }
                  }
              ],
    "asserts":  [
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
