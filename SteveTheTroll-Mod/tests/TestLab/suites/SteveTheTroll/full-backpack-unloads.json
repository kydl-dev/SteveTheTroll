{
    "name":  "full-backpack-unloads",
    "description":  "A full backpack sends the troll to its hub, it unloads into a depot there and is free again",
    "timeout":  240,
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  false,
                                   "slippers":  true,
                                   "hub":  true
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dz":  8,
                                   "dx":  -14
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.observe",
                      "args":  {
                                   "back":  15
                               },
                      "label":  "D-178: the player watches from 15 m back - the trolls work, unload and go to the bed without walking into the player"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.followTroll",
                      "args":  {
                                   "troll":  "troll"
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.fillBackpack",
                      "args":  {
                                   "troll":  "troll"
                               }
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.returningToUnload",
                                    "args":  {
                                                 "troll":  "troll"
                                             },
                                    "expect":  true
                                },
                      "timeout":  30
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.state",
                      "args":  {
                                   "troll":  "troll"
                               }
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.followedBackpackAtMost",
                                    "args":  {
                                                 "stacks":  20
                                             },
                                    "expect":  true
                                },
                      "timeout":  150
                  },
                  {
                      "do":  "wait",
                      "seconds":  3
                  },
                  {
                      "do":  "wait",
                      "seconds":  2
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.followedState",
                      "label":  "followed troll (diagnosis)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.followedConserved",
                      "expect":  true,
                      "label":  "every Stone put in is in the backpack or a depot - nothing lost or made"
                  }
              ],
    "asserts":  [
                    {
                        "check":  "hook",
                        "name":  "stt.followedConserved",
                        "expect":  true,
                        "label":  "items conserved"
                    },
                    {
                        "check":  "hook",
                        "name":  "stt.followedBackpackAtMost",
                        "args":  {
                                     "stacks":  20
                                 },
                        "expect":  true,
                        "label":  "unloaded (a farming troll picks up drops again a moment after the unload - the Stone count proves the delivery)"
                    },
                    {
                        "check":  "hook",
                        "name":  "stt.depotCount",
                        "min":  1,
                        "label":  "a depot received the items"
                    },
                    {
                        "check":  "hook",
                        "name":  "stt.health",
                        "expect":  0
                    },
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
