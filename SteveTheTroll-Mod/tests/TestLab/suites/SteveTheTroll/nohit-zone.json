{
  "name": "nohit-zone",
  "description": "D-171 P5: own tamed trolls never swing within the no-hit radius of the bed (D-097, NoHitRules); outside they do",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "stt.arena",
      "contains": "arena at",
      "label": "start on the arena spot (MIGRATION_DECISIONS C26)"
    },
    {
      "do": "hook",
      "name": "stt.reset"
    },
    {
      "do": "hook",
      "name": "stt.clearTrolls"
    },
    {
      "do": "give",
      "prefab": "STT_TrollSlippers",
      "count": 1,
      "equip": true
    },
    {
      "do": "hook",
      "name": "stt.addHub",
      "args": {
        "number": 1,
        "dx": 0,
        "dz": 25
      }
    },
    {
      "do": "hook",
      "name": "stt.spawnTrollNear",
      "args": {
        "dx": 6,
        "dz": 8
      },
      "as": "near"
    },
    {
      "do": "hook",
      "name": "stt.spawnTroll",
      "args": {
        "dx": -20,
        "dz": 35
      },
      "as": "far"
    },
    {
      "do": "wait",
      "seconds": 2
    }
  ],
  "asserts": [
    {
      "check": "hook",
      "name": "stt.trySwing",
      "args": {
        "troll": "near"
      },
      "expect": false,
      "label": "no swing near the bed"
    },
    {
      "check": "hook",
      "name": "stt.trySwing",
      "args": {
        "troll": "far"
      },
      "expect": true,
      "label": "swings outside the zone"
    },
    {
      "check": "noErrors",
      "source": "SteveTheTroll"
    }
  ]
}
