{
    "name":  "nohit-zone",
    "description":  "D-171 P5: own tamed trolls never swing within the no-hit radius of the bed (D-097, NoHitRules); outside they do",
    "timeout":  60,
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  true,
                                   "slippers":  true,
                                   "hub":  true
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTrollNear",
                      "args":  {
                                   "dx":  6,
                                   "dz":  8
                               },
                      "as":  "near"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  -20,
                                   "dz":  35
                               },
                      "as":  "far"
                  },
                  {
                      "do":  "wait",
                      "seconds":  2
                  }
              ],
    "asserts":  [
                    {
                        "check":  "hook",
                        "name":  "stt.trySwing",
                        "args":  {
                                     "troll":  "near"
                                 },
                        "expect":  false,
                        "label":  "no swing near the bed"
                    },
                    {
                        "check":  "hook",
                        "name":  "stt.trySwing",
                        "args":  {
                                     "troll":  "far"
                                 },
                        "expect":  true,
                        "label":  "swings outside the zone"
                    },
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
