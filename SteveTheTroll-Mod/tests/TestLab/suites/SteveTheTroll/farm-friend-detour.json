{
    "name":  "farm-friend-detour",
    "description":  "D-151 / D-177: a tamed troll standing still on the line between a farming troll and its tree - the farmer steps around it (FarmFriendDetour) and reaches the tree",
    "timeout":  120,
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  true,
                                   "slippers":  true,
                                   "hub":  true
                               }
                  },
                  {
                      "do":  "use",
                      "block":  "openGround",
                      "args":  {
                                   "metres":  100,
                                   "radius":  40
                               }
                  },
                  {
                      "do":  "wait",
                      "seconds":  1
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  0,
                                   "dz":  25
                               },
                      "as":  "blocker"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.freezeMob",
                      "args":  {
                                   "mob":  "blocker"
                               },
                      "expect":  true,
                      "label":  "the friend stands still (its AI is off)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.plantTree",
                      "args":  {
                                   "dx":  0,
                                   "dz":  34
                               },
                      "as":  "tree"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  0,
                                   "dz":  16
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.observe",
                      "args":  {
                                   "back":  15
                               },
                      "label":  "D-178: the player watches from 15 m back - the trolls work, unload and go to the bed without walking into the player"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.startFarm",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "expect":  true
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.plantedUntouched",
                                    "expect":  0
                                },
                      "timeout":  45,
                      "label":  "the farmer got past its friend and hit the tree"
                  }
              ],
    "asserts":  [
                    {
                        "label":  "FarmFriendDetour stepped around the friend",
                        "expect":  true,
                        "source":  "SteveTheTroll",
                        "text":  "steps around",
                        "check":  "logContains"
                    },
                    {
                        "source":  "SteveTheTroll",
                        "check":  "noErrors"
                    }
                ]
}
