{
    "name":  "guard-mob",
    "description":  "D-171 P5: a creature near the troll goes for the player - the troll takes it on (TrollGuard, GuardRules)",
    "timeout":  60,
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  true,
                                   "slippers":  true,
                                   "hub":  true
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  -14,
                                   "dz":  8
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnMob",
                      "args":  {
                                   "prefab":  "Greydwarf",
                                   "dx":  -11,
                                   "dz":  8
                               },
                      "as":  "mob"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.guardTargetOf",
                                    "args":  {
                                                 "mob":  "mob",
                                                 "troll":  "troll"
                                             },
                                    "expect":  "Greydwarf"
                                },
                      "timeout":  8
                  }
              ],
    "asserts":  [
                    {
                        "check":  "hook",
                        "name":  "stt.targetOf",
                        "args":  {
                                     "troll":  "troll"
                                 },
                        "expect":  "Greydwarf"
                    },
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}