{
    "name":  "troll-elemental-immune",
    "timeout":  30,
    "description":  "D-174 (review: World_TrollElementalImmune skips without a tamed troll): a tamed troll is immune to fire, frost, lightning, poison and spirit.",
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  false,
                                   "slippers":  false,
                                   "hub":  false
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  0,
                                   "dz":  16
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.observe",
                      "args":  {
                                   "back":  15
                               },
                      "label":  "D-178: the player watches from 15 m back - the trolls work, unload and go to the bed without walking into the player"
                  },
                  {
                      "do":  "wait",
                      "seconds":  2
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.elementalImmune",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "expect":  5,
                      "label":  "5 elements immune"
                  }
              ],
    "asserts":  [
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
