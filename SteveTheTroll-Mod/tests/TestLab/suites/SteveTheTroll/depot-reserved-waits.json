{
  "name": "depot-reserved-waits",
  "description": "A troll is on its way to a chest (reservation, 90 s): the emptied depot waits, then goes by itself",
  "timeout": 180,
  "steps": [
    { "do": "hook", "name": "stt.arena", "contains": "arena at", "label": "start on the arena spot (MIGRATION_DECISIONS C26)" },
    { "do": "hook", "name": "stt.reset" },
    { "do": "hook", "name": "stt.spawnDepot", "args": { "dz": 8 }, "as": "depot" },
    { "do": "hook", "name": "stt.depotPut", "args": { "frame": "depot", "index": 2, "prefab": "Stone", "count": 5 }, "expect": true },
    { "do": "hook", "name": "stt.depotReserve", "args": { "frame": "depot" } },
    { "do": "hook", "name": "stt.depotTake", "args": { "frame": "depot" } },
    { "do": "wait", "seconds": 10 },
    { "do": "hook", "name": "stt.depotCount", "expect": 1, "label": "waits while reserved" },
    { "do": "wait", "until": { "check": "hook", "name": "stt.depotCount", "expect": 0 }, "timeout": 120 }
  ],
  "asserts": [
    { "check": "hook", "name": "stt.depotCount", "expect": 0 },
    { "check": "noErrors", "source": "SteveTheTroll" }
  ]
}
