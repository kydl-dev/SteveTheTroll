{
    "name":  "chase-push-through",
    "description":  "D-179 / D-181 (user: pathing in clutter): the attack key sends the troll at a frozen Greydwarf; a wall of 7 small beeches stands 4 m in front of the troll across its straight line. The chase must break through the wall (push-through), reach the creature and kill it. fix13: the old layout let the troll reach swing range before any stall, so push-through never ran.",
    "timeout":  120,
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  true,
                                   "slippers":  true,
                                   "hub":  true
                               }
                  },
                  {
                      "do":  "use",
                      "block":  "openGround",
                      "args":  {
                                   "metres":  100,
                                   "radius":  30
                               }
                  },
                  {
                      "do":  "wait",
                      "seconds":  1
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnMob",
                      "args":  {
                                   "prefab":  "Greydwarf",
                                   "dx":  0,
                                   "dz":  15
                               },
                      "as":  "mob"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.freezeMob",
                      "args":  {
                                   "mob":  "mob"
                               },
                      "expect":  true,
                      "label":  "nothing but the key can give the troll this target"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnPrefab",
                      "args":  {
                                   "prefab":  "Beech_small1",
                                   "dx":  -9.08,
                                   "dz":  7.11
                               },
                      "label":  "small beech 1 of 7, a wall 4 m in front of the troll across its line to the creature"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnPrefab",
                      "args":  {
                                   "prefab":  "Beech_small1",
                                   "dx":  -9.53,
                                   "dz":  8
                               },
                      "label":  "small beech 2 of 7, a wall 4 m in front of the troll across its line to the creature"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnPrefab",
                      "args":  {
                                   "prefab":  "Beech_small1",
                                   "dx":  -9.98,
                                   "dz":  8.89
                               },
                      "label":  "small beech 3 of 7, a wall 4 m in front of the troll across its line to the creature"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnPrefab",
                      "args":  {
                                   "prefab":  "Beech_small1",
                                   "dx":  -10.42,
                                   "dz":  9.79
                               },
                      "label":  "small beech 4 of 7, a wall 4 m in front of the troll across its line to the creature"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnPrefab",
                      "args":  {
                                   "prefab":  "Beech_small1",
                                   "dx":  -10.87,
                                   "dz":  10.68
                               },
                      "label":  "small beech 5 of 7, a wall 4 m in front of the troll across its line to the creature"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnPrefab",
                      "args":  {
                                   "prefab":  "Beech_small1",
                                   "dx":  -11.32,
                                   "dz":  11.58
                               },
                      "label":  "small beech 6 of 7, a wall 4 m in front of the troll across its line to the creature"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnPrefab",
                      "args":  {
                                   "prefab":  "Beech_small1",
                                   "dx":  -11.76,
                                   "dz":  12.47
                               },
                      "label":  "small beech 7 of 7, a wall 4 m in front of the troll across its line to the creature"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  -14,
                                   "dz":  8
                               },
                      "as":  "troll",
                      "label":  "the troll appears behind the finished wall (fix15 focus: spawned first, its own AI walked past the wall\u0027s place before the wall stood)"
                  },
                  {
                      "do":  "face",
                      "target":  "mob"
                  },
                  {
                      "do":  "wait",
                      "seconds":  0.5
                  },
                  {
                      "do":  "use",
                      "block":  "pressAttackKeyAt",
                      "args":  {
                                   "target":  "mob",
                                   "expectName":  "Greydwarf"
                               }
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.lastMobHurt",
                                    "args":  {
                                                 "troll":  "troll"
                                             },
                                    "expect":  true
                                },
                      "timeout":  30,
                      "label":  "the troll got through the wall and hurt the creature"
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.guardKillLast",
                                    "args":  {
                                                 "troll":  "troll"
                                             },
                                    "expect":  "dead"
                                },
                      "timeout":  25,
                      "label":  "the creature is dead"
                  }
              ],
    "asserts":  [
                    {
                        "check":  "logContains",
                        "source":  "SteveTheTroll",
                        "text":  "pushes through",
                        "expect":  true,
                        "label":  "the chase broke through the wall instead of walking round"
                    },
                    {
                        "check":  "logContains",
                        "source":  "SteveTheTroll",
                        "text":  "done (enemy dead",
                        "expect":  true,
                        "label":  "the troll itself killed it"
                    },
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
