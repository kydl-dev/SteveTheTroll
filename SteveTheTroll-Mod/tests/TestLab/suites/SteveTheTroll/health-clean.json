{
    "name":  "health-clean",
    "description":  "With a tame troll, a hub and slippers, the runtime health monitor finds nothing wrong",
    "timeout":  60,
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  false,
                                   "slippers":  true,
                                   "hub":  true
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dz":  16,
                                   "dx":  0
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.observe",
                      "args":  {
                                   "back":  15
                               },
                      "label":  "D-178: the player watches from 15 m back - the trolls work, unload and go to the bed without walking into the player"
                  },
                  {
                      "do":  "wait",
                      "seconds":  8
                  }
              ],
    "asserts":  [
                    {
                        "check":  "hook",
                        "name":  "stt.health",
                        "expect":  0,
                        "label":  "no problems found"
                    },
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
