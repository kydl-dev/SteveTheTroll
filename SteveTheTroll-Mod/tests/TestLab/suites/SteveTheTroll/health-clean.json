{
    "name":  "health-clean",
    "description":  "With a tame troll, a hub and slippers, the runtime health monitor finds nothing wrong",
    "timeout":  60,
    "steps":  [
                  {
                      "do":  "hook",
                      "name":  "stt.arena",
                      "contains":  "arena at",
                      "label":  "start on the arena spot (MIGRATION_DECISIONS C26)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.reset"
                  },
                  {
                      "do":  "give",
                      "prefab":  "STT_TrollSlippers",
                      "count":  1,
                      "equip":  true
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.addHub",
                      "args":  {
                                   "number":  1,
                                   "dx":  0,
                                   "dz":  25
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dz":  16,
                                   "dx":  0
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.observe",
                      "args":  {
                                   "back":  15
                               },
                      "label":  "D-178: the player watches from 15 m back - the trolls work, unload and go to the bed without walking into the player"
                  },
                  {
                      "do":  "wait",
                      "seconds":  8
                  }
              ],
    "asserts":  [
                    {
                        "check":  "hook",
                        "name":  "stt.health",
                        "expect":  0,
                        "label":  "no problems found"
                    },
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
