{
  "name": "counter-slam",
  "description": "D-171 P5: a creature hits the troll - first answer is 3 ground slams (D-084, CounterRules)",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "stt.arena",
      "contains": "arena at",
      "label": "start on the arena spot (MIGRATION_DECISIONS C26)"
    },
    {
      "do": "hook",
      "name": "stt.reset"
    },
    {
      "do": "hook",
      "name": "stt.clearTrolls"
    },
    {
      "do": "give",
      "prefab": "STT_TrollSlippers",
      "count": 1,
      "equip": true
    },
    {
      "do": "hook",
      "name": "stt.addHub",
      "args": {
        "number": 1,
        "dx": 0,
        "dz": 25
      }
    },
    {
      "do": "hook",
      "name": "stt.spawnTroll",
      "args": {
        "dx": -10,
        "dz": 13
      },
      "as": "troll"
    },
    {
      "do": "hook",
      "name": "stt.spawnMob",
      "args": {
        "prefab": "Greydwarf",
        "dx": -12,
        "dz": 13
      },
      "as": "mob"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "stt.hitTroll",
      "args": {
        "troll": "troll",
        "attacker": "mob",
        "damage": 5
      }
    },
    {
      "do": "wait",
      "seconds": 0.5
    }
  ],
  "asserts": [
    {
      "check": "hook",
      "name": "stt.combatState",
      "args": {
        "troll": "troll"
      },
      "expect": "slam",
      "label": "slams the ground"
    },
    {
      "check": "noErrors",
      "source": "SteveTheTroll"
    }
  ]
}
