                                   "dz":  13
                               },
                      "as":  "mob"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.hitTroll",
                      "args":  {
                                   "troll":  "troll",
                                   "attacker":  "mob",
