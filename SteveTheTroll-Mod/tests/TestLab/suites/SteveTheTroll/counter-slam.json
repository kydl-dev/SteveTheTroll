                  },
                  {
                      "do":  "wait",
                      "seconds":  0.5
                  }
              ],
    "asserts":  [
                    {
                        "check":  "hook",
                        "name":  "stt.combatState",
                        "args":  {
                                     "troll":  "troll"
                                 },
                        "expect":  "slam",
                        "label":  "slams the ground"
                    },
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
