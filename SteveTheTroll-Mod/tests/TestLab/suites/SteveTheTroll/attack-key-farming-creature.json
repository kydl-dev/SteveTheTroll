{
    "name":  "attack-key-farming-creature",
    "description":  "D-176: the attack key on a creature while the troll is FARMING - the order must end in a fight (TrollGuard.Engage starts the chase), not in a troll that holds the target and stands (the guard-mob-kills defect, reached through the key). The creature is frozen, so only the key can have given the target.",
    "timeout":  90,
    "steps":  [
                  {
                      "do":  "use",
                      "block":  "start",
                      "args":  {
                                   "clearTrolls":  true,
                                   "slippers":  true,
                                   "hub":  true
                               }
                  },
                  {
                      "do":  "use",
                      "block":  "openGround",
                      "args":  {
                                   "metres":  100,
                                   "radius":  30
                               }
                  },
                  {
                      "do":  "wait",
                      "seconds":  1
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnMob",
                      "args":  {
                                   "prefab":  "Greydwarf",
                                   "dx":  0,
                                   "dz":  15
                               },
                      "as":  "mob"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.freezeMob",
                      "args":  {
                                   "mob":  "mob"
                               },
                      "expect":  true,
                      "label":  "D-176: nothing but the key can give the troll this target (TrollGuard cannot see a hunter)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  -14,
                                   "dz":  8
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.startFarm",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "label":  "the troll is farming when the key is pressed"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1.5
                  },
                  {
                      "do":  "face",
                      "target":  "mob"
                  },
                  {
                      "do":  "wait",
                      "seconds":  0.5
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.forcedTargetOf",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "expect":  "",
                      "label":  "no forced target before the key (only the key or a hunter of the player sets one; the troll\u0027s own AI may well target a creature it sees)"
                  },
                  {
                      "do":  "use",
                      "block":  "pressAttackKeyAt",
                      "args":  {
                                   "target":  "mob",
                                   "expectName":  "Greydwarf"
                               }
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.forcedTargetOf",
                                    "args":  {
                                                 "troll":  "troll"
                                             },
                                    "expect":  "Greydwarf"
                                },
                      "timeout":  5,
                      "label":  "phase 1: the key gave the farming troll the order"
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.lastMobHurt",
                                    "expect":  true
                                },
                      "timeout":  20,
                      "label":  "phase 2: the troll walks to the creature and hurts it"
                  },
                  {
                      "do":  "wait",
                      "until":  {
                                    "check":  "hook",
                                    "name":  "stt.guardKillLast",
                                    "args":  {
                                                 "troll":  "troll"
                                             },
                                    "expect":  "dead"
                                },
                      "timeout":  25,
                      "label":  "phase 3: the creature is dead"
                  }
              ],
    "asserts":  [
                    {
                        "check":  "logContains",
                        "source":  "SteveTheTroll",
                        "text":  "key record - press by a test",
                        "expect":  true,
                        "label":  "the key press was recorded"
                    },
                    {
                        "check":  "logContains",
                        "source":  "SteveTheTroll",
                        "text":  "starts (guard / order) at Greydwarf",
                        "expect":  true,
                        "label":  "the order started the chase"
                    },
                    {
                        "check":  "logContains",
                        "source":  "SteveTheTroll",
                        "text":  "done (enemy dead",
                        "expect":  true,
                        "label":  "the troll killed it"
                    },
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
