{
    "name":  "attack-key-ui-blocked",
    "description":  "fix9 analysis (verification checklist): a REAL attack-key press is ignored while a blocking window (here the KY hub) is open - no order is given and the key record says why. The same press with the window closed is attack-key-creature.",
    "timeout":  60,
    "steps":  [
                  {
                      "do":  "hook",
                      "name":  "stt.arena",
                      "contains":  "arena at",
                      "label":  "start on the arena spot (MIGRATION_DECISIONS C26)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.reset"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.clearTrolls"
                  },
                  {
                      "do":  "give",
                      "prefab":  "STT_TrollSlippers",
                      "count":  1,
                      "equip":  true
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.addHub",
                      "args":  {
                                   "number":  1,
                                   "dx":  0,
                                   "dz":  25
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.arenaFurther",
                      "args":  {
                                   "metres":  100
                               }
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.clearAround",
                      "args":  {
                                   "radius":  30
                               },
                      "label":  "no world tree / bush between the player and the target (D-172)"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnMob",
                      "args":  {
                                   "prefab":  "Greydwarf",
                                   "dx":  0,
                                   "dz":  15
                               },
                      "as":  "mob"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.freezeMob",
                      "args":  {
                                   "mob":  "mob"
                               },
                      "expect":  true,
                      "label":  "D-176: nothing but the key can give the troll this target (TrollGuard cannot see a hunter)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.spawnTroll",
                      "args":  {
                                   "dx":  -14,
                                   "dz":  8
                               },
                      "as":  "troll"
                  },
                  {
                      "do":  "wait",
                      "seconds":  1.5
                  },
                  {
                      "do":  "face",
                      "target":  "mob"
                  },
                  {
                      "do":  "wait",
                      "seconds":  0.5
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.forcedTargetOf",
                      "args":  {
                                   "troll":  "troll"
                               },
                      "expect":  "",
                      "label":  "no forced target before the key (only the key or a hunter of the player sets one; the troll\u0027s own AI may well target a creature it sees)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.aimAt",
                      "args":  {
                                   "target":  "mob"
                               },
                      "expect":  true
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.aimedAt",
                      "contains":  "Greydwarf",
                      "label":  "the key ray resolves the creature (aimedAt uses up the one-shot aim)"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.aimAt",
                      "args":  {
                                   "target":  "mob"
                               },
                      "expect":  true
                  },
                  {
                      "do":  "hook",
                      "name":  "kc.hubOpen",
                      "args":  {
                                   "mod":  "com.kydldev.SteveTheTroll"
                               },
                      "expect":  true,
                      "label":  "the hub is open - a blocking window"
                  },
                  {
                      "do":  "hook",
                      "name":  "stt.attackKeyPress",
                      "args":  {
                                   "count":  1
                               }
                  },
                  {
                      "do":  "wait",
                      "seconds":  3
                  },
                  {
                      "do":  "hook",
                      "name":  "kc.hubClose"
                  }
              ],
    "asserts":  [
                    {
                        "check":  "hook",
                        "name":  "stt.forcedTargetOf",
                        "args":  {
                                     "troll":  "troll"
                                 },
                        "expect":  "",
                        "label":  "no order was given"
                    },
                    {
                        "check":  "logContains",
                        "source":  "SteveTheTroll",
                        "text":  "decision refused: a menu, chat or the console is open",
                        "expect":  true,
                        "label":  "the key record names the open window as the reason"
                    },
                    {
                        "check":  "noErrors",
                        "source":  "SteveTheTroll"
                    }
                ]
}
