{
  "name": "full-while-farming",
  "description": "A troll with an active farm job whose backpack fills up drops the job and unloads (D-159 regression)",
  "timeout": 240,
  "steps": [
    {
      "do": "hook",
      "name": "stt.arena",
      "contains": "arena at",
      "label": "start on the arena spot (MIGRATION_DECISIONS C26)"
    },
    {
      "do": "hook",
      "name": "stt.reset"
    },
    {
      "do": "give",
      "prefab": "STT_TrollSlippers",
      "count": 1,
      "equip": true
    },
    {
      "do": "hook",
      "name": "stt.addHub",
      "args": {
        "number": 1,
        "dx": 0,
        "dz": 25
      }
    },
    {
      "do": "hook",
      "name": "stt.spawnTroll",
      "args": {
        "dz": 8,
        "dx": -14
      },
      "as": "troll"
    },
    {
      "do": "hook",
      "name": "stt.startFarm",
      "args": {
        "troll": "troll"
      }
    },
    {
      "do": "wait",
      "seconds": 3
    },
    {
      "do": "hook",
      "name": "stt.state",
      "args": {
        "troll": "troll"
      },
      "contains": "farming",
      "label": "has a farm job"
    },
    {
      "do": "hook",
      "name": "stt.followTroll",
      "args": {
        "troll": "troll"
      }
    },
    {
      "do": "hook",
      "name": "stt.fillBackpack",
      "args": {
        "troll": "troll"
      }
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "stt.returningToUnload",
        "args": {
          "troll": "troll"
        },
        "expect": true
      },
      "timeout": 30
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "stt.followedBackpackAtMost",
        "args": {
          "stacks": 20
        },
        "expect": true
      },
      "timeout": 150
    },
    {
      "do": "wait",
      "seconds": 2
    },
    {
      "do": "hook",
      "name": "stt.followedState",
      "label": "followed troll (diagnosis)"
    },
    {
      "do": "hook",
      "name": "stt.followedConserved",
      "expect": true,
      "label": "every Stone put in is in the backpack or a depot - nothing lost or made"
    }
  ],
  "asserts": [
    {
      "check": "hook",
      "name": "stt.followedConserved",
      "expect": true,
      "label": "items conserved"
    },
    {
      "check": "hook",
      "name": "stt.followedBackpackAtMost",
      "args": {
        "stacks": 20
      },
      "expect": true,
      "label": "unloaded (a farming troll picks up drops again a moment after the unload - the Stone count proves the delivery)"
    },
    {
      "check": "noErrors",
      "source": "SteveTheTroll"
    }
  ]
}
