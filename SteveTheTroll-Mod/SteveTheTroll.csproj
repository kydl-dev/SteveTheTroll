<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SteveTheTroll mod. Everything shared by the user's mods (references from E:\Projects\Valheim\Claude\ref, net48, no debug symbols,
    the shared code Kydl.Common / Kydl.Ui, copy to Assets + build, embedded bundle) comes from Claude\shared\Kydl.Mod.props / .targets.
    Add here only what is special about this mod (an extra reference: put the DLL into Claude\ref and add a line below).
    Build: dotnet build "SteveTheTroll-Mod\SteveTheTroll.csproj" -c Release
  -->
  <Import Project="..\..\Claude\shared\Kydl.Mod.props"/>

  <PropertyGroup>
    <AssemblyName>SteveTheTroll</AssemblyName>
    <RootNamespace>SteveTheTroll</RootNamespace>
    <PackageId>SteveTheTroll</PackageId>
    <!-- AssetBundle built by the Unity project (Valheim > Build AssetBundles); embedded into the DLL when Assets\stevethetroll exists -->
    <BundleName>stevethetroll</BundleName>
    <!-- 2.0.0: the UI kit, the input lock and the KY hub come from KydlCore.dll (a hard dependency), not from a copy in this DLL -->
    <KydlUseCore>true</KydlUseCore>
    <!-- KydlDev spec layout (MIGRATION_DECISIONS A8): the DLL goes to assets\ only -->
    <KydlBuildFolder>false</KydlBuildFolder>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**;docs\**;release\**"/>
    <None Remove="tests\**;docs\**;release\**"/>
    <EmbeddedResource Remove="tests\**;docs\**;release\**"/>
  </ItemGroup>

  <ItemGroup>
    <!-- T-200: the Troll Hub's build menu icon (the word HUB on a wooden plaque), loaded by EmbeddedImages; no Unity rebuild needed -->
    <EmbeddedResource Include="src\Features\Hubs\Infrastructure\HubIcon.png" LogicalName="stevethetroll_hub_icon.png"/>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ValheimRefs)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- the mod's menu views live in the Unity project (previewed there) and are compiled into the mod from there -->
    <Compile Include="..\SteveTheTroll-Unity\Assets\SteveTheTroll_UI\Runtime\*.cs" Link="UiViews\%(Filename)%(Extension)"/>
    <!-- D-014: the troll fit math + the fit saved in Unity are compiled into the mod from there (same code in the fit scene and in game) -->
    <Compile Include="..\SteveTheTroll-Unity\Assets\SteveTheTroll_Fit\Runtime\*.cs" Link="Fit\%(Filename)%(Extension)"/>
  </ItemGroup>

  <!-- Test-quality runs only (KydlQuality=true, _agent\tools\test-quality.ps1 / sonar.ps1): the unit tests use the mod's own internal UI
       types instead of linked copies, so Stryker's mutated mod DLL is the code the tests run (D-086). Never set in a release build.
       (An attribute file, not an <InternalsVisibleTo> item: Kydl.Mod.props turns GenerateAssemblyInfo off.) -->
  <ItemGroup>
    <Compile Remove="quality\**"/>
    <Compile Include="quality\QualityAccess.cs" Condition="'$(KydlQuality)' == 'true'"/>
  </ItemGroup>

  <Import Project="..\..\Claude\shared\Kydl.Mod.targets"/>
</Project>
